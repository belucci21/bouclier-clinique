# Empty means the Node API is mounted on the same origin at /api.
# For an API subdomain use an HTTPS origin without a trailing slash.
VITE_API_BASE_URL=
# Required in the browser build only when PAYMENTS_ENABLED=true on the API.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Recommended browser credential. Safe to expose; never use the service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only.
VITE_SUPABASE_ANON_KEY=
